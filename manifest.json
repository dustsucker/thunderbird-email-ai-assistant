{
  "manifest_version": 3,
  "name": "Email Assistant",
  "version": "1.0.4",
  "description": "Automatically tags messages based on AI rules",
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "messagesModifyPermanent",
    "accountsRead",
    "storage",
    "menus",
    "notifications",
    "messagesTags",
    "messagesTagsList"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.mistral.ai/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://api.z.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' https://api.openai.com https://generativelanguage.googleapis.com https://api.anthropic.com https://api.mistral.ai https://api.deepseek.com https://openrouter.ai https://api.z.ai http://localhost:* http://127.0.0.1:* https://localhost:* https://127.0.0.1:*"
  },
  "background": {
    "page": "background.html"
  },
  "action": {
    "default_title": "AI-Analyse",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-assistant-0.1@entestat.com"
    }
  }
}
